generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  passwordHash       String
  name               String
  headline           String?
  about              String?
  location           String?
  avatarUrl          String?
  coverUrl           String?
  pronouns           String?
  openTo             String[]                 @default([])
  isSuperAdmin       Boolean                  @default(false)
  isActive           Boolean                  @default(true)
  mustChangePassword Boolean                  @default(false)
  /// Null until the address is confirmed (public sign-up, SOT D22). Admin-created and seeded accounts default to verified.
  emailVerifiedAt    DateTime?                @default(now())
  lastSeenAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  search             Unsupported("tsvector")? @default(dbgenerated()) /// generated column + GIN index, see migration full_text_search

  memberships        Membership[]
  grants             RoleGrant[]
  experiences        Experience[]
  educations         Education[]
  skills             Skill[]
  endorsementsGiven  Endorsement[]            @relation("endorser")
  posts              Post[]
  comments           Comment[]
  reactions          Reaction[]
  savedPosts         SavedPost[]
  pollVotes          PollVote[]
  sentRequests       Connection[]             @relation("requester")
  receivedRequests   Connection[]             @relation("addressee")
  following          Follow[]                 @relation("follower")
  followers          Follow[]                 @relation("followee")
  hashtagFollows     HashtagFollow[]
  conversationMember ConversationMember[]
  messages           Message[]
  notifications      Notification[]           @relation("recipient")
  notificationsSent  Notification[]           @relation("actor")
  groupMembers       GroupMember[]
  groupsCreated      Group[]
  events             Event[]
  eventRsvps         EventRsvp[]
  articles           Article[]
  newsletters        Newsletter[]
  newsletterSubs     NewsletterSubscription[]
  jobs               Job[]
  jobApplications    JobApplication[]
  savedJobs          SavedJob[]
  reports            Report[]                 @relation("reporter")
  reportsReviewed    Report[]                 @relation("reviewer")
  auditLogs          AuditLog[]
  profileViews       ProfileView[]            @relation("viewed")
  profileViewsMade   ProfileView[]            @relation("viewer")
  authSessions       AuthSession[]
  orgMemberships     OrgMember[]
  emailTokens        EmailToken[]
  companyFollows     CompanyFollow[]
  orgInvitesSent     OrgInvite[]

  @@index([search], type: Gin)
}

/// One row per sign-in (SOT §8). Holds the hash of the current refresh token; rotated on every refresh.
model AuthSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  /// Hash of the token rotated out last; presenting it again means theft → session revoked.
  prevHash    String?   @unique
  method      String // "password" | "sso:<provider>"
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([userId])
}

/// In-flight OIDC sign-in: created at /auth/sso/:id/start, completed by the IdP callback, consumed by /auth/sso/exchange.
model SsoRequest {
  id           String   @id // the OIDC `state`
  provider     String
  redirectUri  String // loopback URL of the desktop app
  challenge    String // PKCE S256 challenge from the desktop app
  nonce        String
  codeVerifier String // PKCE verifier for the server ↔ IdP leg
  codeHash     String?  @unique
  userId       String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// ───────────────────────── Organizations (SOT §14) ─────────────────────────

enum JoinPolicy {
  AUTO
  APPROVAL
  INVITE
}

enum OrgMemberStatus {
  ACTIVE
  PENDING
  LEFT
}

/// A company (tenant). Company-scoped rows carry its id; see SOT D21.
model Organization {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  logoUrl    String?
  coverUrl   String?
  about      String?
  website    String?
  industry   String?
  size       String?
  joinPolicy JoinPolicy @default(INVITE)
  /// Set by a platform admin (multi mode); members lose access to the org while set.
  suspendedAt DateTime?
  createdAt  DateTime   @default(now())

  members     OrgMember[]
  domains     OrgDomain[]
  nodes       OrgNode[]
  roles       Role[]
  auditLogs   AuditLog[]
  reports     Report[]
  groups      Group[]
  events      Event[]
  jobs        Job[]
  newsletters Newsletter[]
  followers   CompanyFollow[]
  invites     OrgInvite[]
  posts       Post[]
}

model OrgMember {
  orgId      String
  userId     String
  status     OrgMemberStatus @default(ACTIVE)
  isOrgAdmin Boolean         @default(false)
  joinedAt   DateTime        @default(now())
  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([orgId, userId])
  @@index([userId])
}

/// Email domain a company claims; verification flow is phase 2b.
model OrgDomain {
  id                String       @id @default(cuid())
  orgId             String
  domain            String
  verificationToken String
  verifiedAt        DateTime?
  createdAt         DateTime     @default(now())
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, domain])
  @@index([domain])
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// Single-use email link tokens (SOT §8). Only the SHA-256 hash is stored.
model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  purpose   EmailTokenPurpose
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// Email invite to join an org (join policy INVITE, or people outside its domains).
model OrgInvite {
  id          String       @id @default(cuid())
  orgId       String
  email       String
  tokenHash   String       @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy   User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
}

model CompanyFollow {
  userId    String
  orgId     String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
  @@index([orgId])
}

// ───────────────────────── Hierarchy DAG ─────────────────────────

enum OrgNodeType {
  COMPANY
  DIVISION
  DEPARTMENT
  TEAM
  GUILD
  LOCATION
  CUSTOM
}

model OrgNode {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  type        OrgNodeType  @default(TEAM)
  description String?
  isRoot      Boolean      @default(false)
  createdAt   DateTime     @default(now())

  parentEdges OrgEdge[]    @relation("child")
  childEdges  OrgEdge[]    @relation("parent")
  memberships Membership[]
  grants      RoleGrant[]
  postAudience PostAudienceNode[]
  jobs        Job[]
  groups      Group[]
  events      Event[]

  @@index([orgId])
}

model OrgEdge {
  parentId  String
  childId   String
  createdAt DateTime @default(now())
  parent    OrgNode  @relation("parent", fields: [parentId], references: [id], onDelete: Cascade)
  child     OrgNode  @relation("child", fields: [childId], references: [id], onDelete: Cascade)

  @@id([parentId, childId])
  @@index([childId])
}

model Membership {
  userId    String
  nodeId    String
  title     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  node      OrgNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId])
  @@index([nodeId])
}

// ───────────────────────── RBAC ─────────────────────────

model Role {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  permissions String[]
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  grants      RoleGrant[]

  @@unique([orgId, name])
}

/// userId = null → node grant (all members of node + descendants). Scope is always the sub-DAG at nodeId.
model RoleGrant {
  id        String   @id @default(cuid())
  roleId    String
  nodeId    String
  userId    String?
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  node      OrgNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roleId, nodeId, userId])
  @@index([userId])
}

// ───────────────────────── Profile ─────────────────────────

model Experience {
  id          String    @id @default(cuid())
  userId      String
  title       String
  company     String
  location    String?
  startDate   DateTime
  endDate     DateTime?
  description String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Education {
  id        String    @id @default(cuid())
  userId    String
  school    String
  degree    String?
  field     String?
  startDate DateTime?
  endDate   DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id           String                   @id @default(cuid())
  userId       String
  name         String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endorsements Endorsement[]
  search       Unsupported("tsvector")? @default(dbgenerated()) /// generated column + GIN index, see migration full_text_search

  @@unique([userId, name])
  @@index([search], type: Gin)
}

model Endorsement {
  skillId    String
  endorserId String
  createdAt  DateTime @default(now())
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  endorser   User     @relation("endorser", fields: [endorserId], references: [id], onDelete: Cascade)

  @@id([skillId, endorserId])
}

model ProfileView {
  id        String   @id @default(cuid())
  viewedId  String
  viewerId  String
  createdAt DateTime @default(now())
  viewed    User     @relation("viewed", fields: [viewedId], references: [id], onDelete: Cascade)
  viewer    User     @relation("viewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@index([viewedId, createdAt])
}

// ───────────────────────── Network ─────────────────────────

enum ConnectionStatus {
  PENDING
  ACCEPTED
  IGNORED
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      ConnectionStatus @default(PENDING)
  message     String?
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  requester   User             @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

model Follow {
  followerId String
  followeeId String
  createdAt  DateTime @default(now())
  follower   User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
}

// ───────────────────────── Feed ─────────────────────────

enum PostKind {
  TEXT
  MEDIA
  DOCUMENT
  POLL
  ARTICLE
  REPOST
  CELEBRATION
  EVENT
  JOB
}

/// Who may see a post (SOT §14.2). ORG posts carry `orgId`; `PostAudienceNode` narrows them to units.
enum PostVisibility {
  PUBLIC
  CONNECTIONS
  ORG
}

enum ReactionType {
  LIKE
  CELEBRATE
  SUPPORT
  LOVE
  INSIGHTFUL
  FUNNY
}

model Post {
  id          String                   @id @default(cuid())
  authorId    String
  kind        PostKind                 @default(TEXT)
  visibility  PostVisibility           @default(ORG)
  /// Audience org of an ORG post; filled by a trigger from the group/event/job or the author's first org when omitted.
  orgId       String?
  body        String                   @default("")
  celebration String?
  repostOfId  String?
  articleId   String?                  @unique
  eventId     String?
  jobId       String?
  groupId     String?
  isPinned    Boolean                  @default(false)
  isHidden    Boolean                  @default(false)
  /// When a moderator hid it; purged after RETENTION_HIDDEN_CONTENT_DAYS (SOT §11).
  hiddenAt    DateTime?
  editedAt    DateTime?
  createdAt   DateTime                 @default(now())
  author      User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  repostOf    Post?                    @relation("reposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts     Post[]                   @relation("reposts")
  article     Article?                 @relation(fields: [articleId], references: [id], onDelete: Cascade)
  event       Event?                   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  job         Job?                     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  group       Group?                   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  media       PostMedia[]
  poll        Poll?
  reactions   Reaction[]
  comments    Comment[]
  savedBy     SavedPost[]
  hashtags    PostHashtag[]
  reports     Report[]
  org         Organization?            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  audience    PostAudienceNode[]
  search      Unsupported("tsvector")? @default(dbgenerated()) /// generated column + GIN index, see migration full_text_search

  @@index([search], type: Gin)
  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([groupId, createdAt])
  @@index([hiddenAt])
  @@index([orgId, createdAt])
}

/// Units an ORG post targets; members of these units or any unit below them see it (SOT §14.2).
model PostAudienceNode {
  postId String
  nodeId String
  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  node   OrgNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([postId, nodeId])
  @@index([nodeId])
}

model PostMedia {
  id        String  @id @default(cuid())
  postId    String
  url       String
  mimeType  String
  fileName  String?
  sortOrder Int     @default(0)
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Poll {
  id       String       @id @default(cuid())
  postId   String       @unique
  question String
  endsAt   DateTime
  post     Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  options  PollOption[]
  votes    PollVote[]
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  text      String
  sortOrder Int
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]
}

model PollVote {
  pollId    String
  userId    String
  optionId  String
  createdAt DateTime   @default(now())
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
}

model Reaction {
  id        String       @id @default(cuid())
  userId    String
  type      ReactionType
  postId    String?
  commentId String?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
}

model Comment {
  id        String     @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  body      String
  isHidden  Boolean    @default(false)
  hiddenAt  DateTime?
  editedAt  DateTime?
  createdAt DateTime   @default(now())
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?   @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]  @relation("replies")
  reactions Reaction[]
  reports   Report[]

  @@index([postId, createdAt])
  @@index([hiddenAt])
}

model SavedPost {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Hashtag {
  id        String          @id @default(cuid())
  tag       String          @unique
  posts     PostHashtag[]
  followers HashtagFollow[]
}

model PostHashtag {
  postId    String
  hashtagId String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
}

model HashtagFollow {
  userId    String
  hashtagId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([userId, hashtagId])
}

// ───────────────────────── Messaging ─────────────────────────

model Conversation {
  id        String               @id @default(cuid())
  title     String?
  isGroup   Boolean              @default(false)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime     @default(now())
  joinedAt       DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  attachmentUrl  String?
  attachmentName String?
  attachmentMime String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ───────────────────────── Notifications ─────────────────────────

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  actorId     String?
  type        String
  text        String
  link        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  recipient   User      @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?     @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
}

// ───────────────────────── Groups ─────────────────────────

enum GroupPrivacy {
  PUBLIC
  PRIVATE
}

enum GroupRole {
  ADMIN
  MODERATOR
  MEMBER
  PENDING
}

model Group {
  id          String                   @id @default(cuid())
  name        String
  description String?
  rules       String?
  privacy     GroupPrivacy             @default(PUBLIC)
  coverUrl    String?
  /// null = public/personal (SOT §14.2)
  orgId       String?
  org         Organization?            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  nodeId      String?
  creatorId   String
  createdAt   DateTime                 @default(now())
  node        OrgNode?                 @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  creator     User                     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  posts       Post[]
  search      Unsupported("tsvector")? @default(dbgenerated()) /// generated column + GIN index, see migration full_text_search

  @@index([search], type: Gin)
}

model GroupMember {
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

// ───────────────────────── Events ─────────────────────────

enum RsvpStatus {
  GOING
  INTERESTED
  NOT_GOING
}

model Event {
  id          String                   @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  isOnline    Boolean                  @default(true)
  location    String?
  link        String?
  coverUrl    String?
  /// null = public/personal (SOT §14.2)
  orgId       String?
  org         Organization?            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  nodeId      String?
  organizerId String
  createdAt   DateTime                 @default(now())
  node        OrgNode?                 @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  organizer   User                     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  rsvps       EventRsvp[]
  posts       Post[]
  search      Unsupported("tsvector")? @default(dbgenerated()) /// generated column + GIN index, see migration full_text_search

  @@index([search], type: Gin)
}

model EventRsvp {
  eventId   String
  userId    String
  status    RsvpStatus
  createdAt DateTime   @default(now())
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

// ───────────────────────── Articles / newsletters ─────────────────────────

model Newsletter {
  id          String                   @id @default(cuid())
  /// null = personal newsletter (SOT §14.2)
  orgId       String?
  org         Organization?            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title       String
  description String?
  ownerId     String
  createdAt   DateTime                 @default(now())
  owner       User                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  articles    Article[]
  subscribers NewsletterSubscription[]
}

model NewsletterSubscription {
  newsletterId String
  userId       String
  createdAt    DateTime   @default(now())
  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([newsletterId, userId])
}

model Article {
  id           String                   @id @default(cuid())
  authorId     String
  newsletterId String?
  title        String
  body         String
  coverUrl     String?
  publishedAt  DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  author       User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  newsletter   Newsletter?              @relation(fields: [newsletterId], references: [id], onDelete: SetNull)
  post         Post?
  search       Unsupported("tsvector")? @default(dbgenerated()) /// generated column + GIN index, see migration full_text_search

  @@index([search], type: Gin)
}

// ───────────────────────── Jobs ─────────────────────────

enum JobStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  INTERVIEW
  OFFER
  REJECTED
  HIRED
}

model Job {
  id           String                   @id @default(cuid())
  title        String
  description  String
  location     String?
  workplace    String                   @default("ONSITE")
  employment   String                   @default("FULL_TIME")
  skills       String[]                 @default([])
  status       JobStatus                @default(OPEN)
  /// null = public/personal (SOT §14.2)
  orgId        String?
  org          Organization?            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  nodeId       String?
  posterId     String
  createdAt    DateTime                 @default(now())
  node         OrgNode?                 @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  poster       User                     @relation(fields: [posterId], references: [id], onDelete: Cascade)
  applications JobApplication[]
  savedBy      SavedJob[]
  posts        Post[]
  search       Unsupported("tsvector")? @default(dbgenerated()) /// generated column + GIN index, see migration full_text_search

  @@index([search], type: Gin)
}

model JobApplication {
  id        String            @id @default(cuid())
  jobId     String
  userId    String
  note      String?
  status    ApplicationStatus @default(APPLIED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
}

model SavedJob {
  userId String
  jobId  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
}

// ───────────────────────── Moderation ─────────────────────────

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED
}

model Report {
  id           String       @id @default(cuid())
  /// The org whose moderators review it.
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reporterId   String
  postId       String?
  commentId    String?
  targetUserId String?
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  resolution   String?
  reviewerId   String?
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
  reporter     User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  post         Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([orgId, status, createdAt])
}

model AuditLog {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorId   String
  action    String
  target    String?
  meta      Json?
  createdAt DateTime     @default(now())
  actor     User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}
