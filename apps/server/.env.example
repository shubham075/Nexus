DATABASE_URL="postgresql://nexus:nexus@127.0.0.1:5434/nexus?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
PUBLIC_URL="http://localhost:4000"
# single = one internal company, no org switcher (default); multi = public SaaS with many orgs (SOT D23)
TENANCY="single"
S3_ENDPOINT="http://127.0.0.1:8334"
S3_REGION="us-east-1"
S3_BUCKET="nexus-media"
S3_ACCESS_KEY="nexus"
S3_SECRET_KEY="nexus-secret"
# Optional: Socket.IO Redis adapter + shared presence (needed when running more than one API instance).
# Unset = single instance, in-memory (`docker compose up -d` starts Redis on :6381).
# REDIS_URL="redis://127.0.0.1:6381"
# Signed media URLs (SOT §8). Unset secret = derived from JWT_SECRET.
MEDIA_URL_SECRET=""
MEDIA_URL_TTL_SECONDS=3600
# Retention in days, 0 = keep forever (SOT §1 P1, awaiting confirmation)
RETENTION_HIDDEN_CONTENT_DAYS=30
RETENTION_MESSAGE_DAYS=730
RETENTION_READ_NOTIFICATION_DAYS=90
RETENTION_NOTIFICATION_DAYS=365
RETENTION_AUDIT_LOG_DAYS=0
RETENTION_PURGE_EVERY_HOURS=24
# Email (SOT §8 → Email). Dev: Mailpit from `docker compose up -d`, inbox at http://localhost:8026.
# Use SMTP_URL (smtp:// or smtps://user:pass@host:port) or SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS/SMTP_SECURE.
# Unset = mails are logged to the console instead of sent.
SMTP_URL="smtp://127.0.0.1:1026"
MAIL_FROM="Nexus <no-reply@nexus.local>"
# SMTP_TIMEOUT_MS=10000
SEED_ADMIN_EMAIL="admin@nexus.local"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_DEMO_PASSWORD="Welcome@123"
# Desktop update feed folder served at /updates/ (latest.yml, Nexus-Setup-<v>.exe, .blockmap)
UPDATES_DIR="updates"
# Auth (SOT §8)
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# RATE_LIMIT=off            # disables rate limiting (tests only)
# TRUST_PROXY=true          # behind a reverse proxy, so rate limits see the client IP
# SSO (OIDC), see README → "Single sign-on". Leave OIDC_PROVIDERS empty to disable.
OIDC_PROVIDERS=""
# OIDC_MICROSOFT_LABEL="Microsoft"
# OIDC_MICROSOFT_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
# OIDC_MICROSOFT_CLIENT_ID=""
# OIDC_MICROSOFT_CLIENT_SECRET=""
# OIDC_MICROSOFT_EMAIL_CLAIM="preferred_username"
# OIDC_MICROSOFT_ALLOWED_DOMAINS="yourcompany.com"
# OIDC_GOOGLE_LABEL="Google"
# OIDC_GOOGLE_ISSUER="https://accounts.google.com"
# OIDC_GOOGLE_CLIENT_ID=""
# OIDC_GOOGLE_CLIENT_SECRET=""
# OIDC_GOOGLE_ALLOWED_DOMAINS="yourcompany.com"
