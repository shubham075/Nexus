# Nexus production settings. Copy to deploy/.env.prod (git-ignored) and fill in every CHANGE-ME.
# Used twice: by `docker compose --env-file` (variable substitution) and as the API container's env_file.
# Generate secrets with:  openssl rand -hex 32
# Use hex/alphanumeric secrets: POSTGRES_PASSWORD is embedded in a URL.

# ---------- Compose ----------
# Optional services: s3 (bundled SeaweedFS), redis, backup. Comma-separated.
COMPOSE_PROFILES=s3,backup
# Image to run. Leave as nexus-api:local to build from source on this host,
# or point at your registry, e.g. registry.yourcompany.internal/nexus-api:0.1.0
NEXUS_API_IMAGE=nexus-api:local

# ---------- Reverse proxy (Caddy) ----------
# Hostname clients use; set apiUrl in nexus.config.json to https://<NEXUS_DOMAIN>
NEXUS_DOMAIN=nexus.yourcompany.internal
# internal | you@company.com (Let's Encrypt) | /certs/fullchain.pem /certs/key.pem (company CA)
CADDY_TLS=internal
HTTP_PORT=80
HTTPS_PORT=443

# ---------- API ----------
# Must be the https URL clients reach (used to build media links).
PUBLIC_URL=https://nexus.yourcompany.internal
# Signs login tokens. At least 32 random bytes; rotating it signs everyone out.
JWT_SECRET=CHANGE-ME-openssl-rand-hex-32
LOG_LEVEL=info
TRUST_PROXY=true

# ---------- PostgreSQL ----------
POSTGRES_PASSWORD=CHANGE-ME-openssl-rand-hex-24
# Leave unset to use the bundled postgres service. For a managed database set the full URL:
# DATABASE_URL=postgresql://nexus:<password>@db.yourcompany.internal:5432/nexus?schema=public&sslmode=require

# ---------- Object storage (S3-compatible) ----------
# Leave S3_ENDPOINT unset with the s3 profile (bundled SeaweedFS at http://s3:8333).
# For AWS S3: S3_ENDPOINT=https://s3.<region>.amazonaws.com ; for MinIO: its URL.
# S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=nexus-media
S3_ACCESS_KEY=CHANGE-ME-openssl-rand-hex-12
S3_SECRET_KEY=CHANGE-ME-openssl-rand-hex-32
# Signs time-limited media URLs (phase 1c media hardening).
MEDIA_URL_SECRET=CHANGE-ME-openssl-rand-hex-32

# ---------- Redis (optional, profile "redis") ----------
# Socket.IO fan-out + shared presence; needed only with more than one API instance.
# REDIS_URL=redis://redis:6379

# ---------- Single sign-on (OIDC, optional) ----------
# Comma-separated provider ids, e.g. MICROSOFT,GOOGLE. Empty = email + password only.
OIDC_PROVIDERS=
# OIDC_MICROSOFT_LABEL=Microsoft
# OIDC_MICROSOFT_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_MICROSOFT_CLIENT_ID=
# OIDC_MICROSOFT_CLIENT_SECRET=
# OIDC_MICROSOFT_EMAIL_CLAIM=preferred_username
# OIDC_MICROSOFT_ALLOWED_DOMAINS=yourcompany.com
# OIDC_GOOGLE_LABEL=Google
# OIDC_GOOGLE_ISSUER=https://accounts.google.com
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_GOOGLE_ALLOWED_DOMAINS=yourcompany.com
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30

# ---------- Desktop auto-update feed (optional) ----------
# Host folder with latest.yml + Nexus-Setup-<v>.exe(.blockmap), served at /updates/.
UPDATES_HOST_DIR=./updates
UPDATES_DIR=/app/updates

# ---------- Monitoring ----------
# Prometheus endpoint at http://api:4000/metrics (internal network only; the proxy blocks it).
METRICS_ENABLED=true
# Optional bearer token Prometheus must send.
# METRICS_TOKEN=

# ---------- Backups (profile "backup") ----------
# Host folder for dumps and the media mirror. Put it on a different disk than the Docker volumes.
BACKUP_DIR=./backups
# Cron schedule in the container's TZ.
BACKUP_CRON="30 2 * * *"
TZ=Asia/Kolkata
BACKUP_KEEP_DAYS=14
# Optional off-site copy (rclone remote), e.g. an S3 bucket in another account:
# BACKUP_REMOTE=offsite:nexus-backups
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=AWS
# RCLONE_CONFIG_OFFSITE_REGION=ap-south-1
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=

# ---------- First run only ----------
# Used by `… run --rm api seed` to create the first super admin (and the demo company).
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=CHANGE-ME-then-change-again-after-first-sign-in
SEED_DEMO_PASSWORD=CHANGE-ME-openssl-rand-hex-12
